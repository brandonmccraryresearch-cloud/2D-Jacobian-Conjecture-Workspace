lemma topA_of_ge {L : Type*} [Field L] (w : L) (i : ℕ) (h : 9 ≤ i) : topA w i = 0 := by
  obtain ⟨j, rfl⟩ : ∃ j, i = j + 9 := ⟨i - 9, by omega⟩
  rfl
lemma topB_of_ge {L : Type*} [Field L] (w : L) (i : ℕ) (h : 13 ≤ i) : topB w i = 0 := by
  obtain ⟨j, rfl⟩ : ∃ j, i = j + 13 := ⟨i - 13, by omega⟩
  rfl

