      layerTerm 2 2 A₂ B₂ + layerTerm 1 3 A₁ B₃ = 0 ∧
      layerTerm 2 1 A₂ B₁ + layerTerm 1 2 A₁ B₂ + layerTerm 0 3 A₀ B₃ = 0 ∧
      layerTerm 2 0 A₂ B₀ + layerTerm 1 1 A₁ B₁ + layerTerm 0 2 A₀ B₂ = 0 ∧
      (∀ i, A₀.coeff i ≠ 0 → 0 ≤ i ∧ i ≤ 8) ∧ (∀ i, A₁.coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 8) ∧
      (∀ i, A₂.coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 8) ∧ (∀ i, B₀.coeff i ≠ 0 → 0 ≤ i ∧ i ≤ 12) ∧
      (∀ i, B₁.coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 12) ∧ (∀ i, B₂.coeff i ≠ 0 → 2 ≤ i ∧ i ≤ 12) ∧
      (∀ i, B₃.coeff i ≠ 0 → 2 ≤ i ∧ i ≤ 12) ∧
      (∀ i, A₂.coeff i = topA w i) ∧ (∀ k, B₃.coeff k = topB w k) ∧ B₀.coeff 12 = 0 := by
  set A₂ : Polynomial L := ∑ j ∈ Finset.range 9, Polynomial.C (topA w j) * Polynomial.X ^ j with hA₂
  set B₃ : Polynomial L := ∑ j ∈ Finset.range 13, Polynomial.C (topB w j) * Polynomial.X ^ j with hB₃
  have cA : ∀ i, A₂.coeff i = topA w i := by
    intro i; rw [hA₂, coeff_sum_C_mul_X_pow]; split_ifs with h
    · rfl
