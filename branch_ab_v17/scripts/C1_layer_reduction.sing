// =====================================================================
// Tier 2 (Muse/Singular) -- C1: Layer reduction identity
// G6 Handoff Spec, checkpoint C1.
// Derives everything from the polygons stated in the spec (which the
// source gate extracts from GGHV Prop. 4.3); no original-package code.
// Verifies, with all 72 coefficients symbolic:
//   [P,Q] - x^2 = y^2 * ( sum_{s=1..5} y^-(s+1) E_s - u^2 y^-6 ),
//   E_s = sum_{k+l=s} ( k A_k B_l' - l A_k' B_l ),  u = x y^2,
// and logs the u-degree range (= number of scalar equations) of each E_s.
// =====================================================================

ring R = 0, (a(1..25), b(1..47), uu, x, y), dp;

// Lattice points of N(P) = conv{(0,0),(1,0),(8,14),(8,16)} (25 points,
// enumerated independently by half-plane test; count verified = 25).
intmat Pp[25][2] =
  0,0,  1,0,  1,1,  1,2,  2,2,  2,3,  2,4,  3,4,  3,5,  3,6,
  4,6,  4,7,  4,8,  5,8,  5,9,  5,10, 6,10, 6,11, 6,12,
  7,12, 7,13, 7,14, 8,14, 8,15, 8,16;

// Lattice points of N(Q) = conv{(0,0),(2,1),(12,21),(12,24)} (47 points).
intmat Qq[47][2] =
  0,0,  1,1,  1,2,  2,1,  2,2,  2,3,  2,4,  3,3,  3,4,  3,5,  3,6,
  4,5,  4,6,  4,7,  4,8,  5,7,  5,8,  5,9,  5,10, 6,9,  6,10, 6,11, 6,12,
  7,11, 7,12, 7,13, 7,14, 8,13, 8,14, 8,15, 8,16,
  9,15, 9,16, 9,17, 9,18, 10,17, 10,18, 10,19, 10,20,
  11,19, 11,20, 11,21, 11,22, 12,21, 12,22, 12,23, 12,24;

poly P = 0;
int i;
for (i = 1; i <= 25; i++) { P = P + a(i)*x^Pp[i,1]*y^Pp[i,2]; }
poly Q = 0;
for (i = 1; i <= 47; i++) { Q = Q + b(i)*x^Qq[i,1]*y^Qq[i,2]; }

poly J = diff(P,x)*diff(Q,y) - diff(P,y)*diff(Q,x);

// Layer polynomials in the formal variable uu (= x*y^2).
poly A0=0; poly A1=0; poly A2=0;
poly A0d=0; poly A1d=0; poly A2d=0;
for (i = 1; i <= 25; i++)
{
  int px = Pp[i,1]; int k = 2*px - Pp[i,2];
  poly t = a(i)*uu^px;
  poly dt = 0;
  if (px > 0) { dt = a(i)*px*uu^(px-1); }
  if (k == 0) { A0 = A0 + t; A0d = A0d + dt; }
  if (k == 1) { A1 = A1 + t; A1d = A1d + dt; }
  if (k == 2) { A2 = A2 + t; A2d = A2d + dt; }
}
poly B0=0; poly B1=0; poly B2=0; poly B3=0;
poly B0d=0; poly B1d=0; poly B2d=0; poly B3d=0;
for (i = 1; i <= 47; i++)
{
  int qx = Qq[i,1]; int l = 2*qx - Qq[i,2];
  poly t = b(i)*uu^qx;
  poly dt = 0;
  if (qx > 0) { dt = b(i)*qx*uu^(qx-1); }
  if (l == 0) { B0 = B0 + t; B0d = B0d + dt; }
  if (l == 1) { B1 = B1 + t; B1d = B1d + dt; }
  if (l == 2) { B2 = B2 + t; B2d = B2d + dt; }
  if (l == 3) { B3 = B3 + t; B3d = B3d + dt; }
}

poly E1 = -A0d*B1 + A1*B0d;
poly E2 = -2*A0d*B2 + (A1*B1d - A1d*B1) + 2*A2*B0d;
poly E3 = -3*A0d*B3 + (A1*B2d - 2*A1d*B2) + (2*A2*B1d - A2d*B1);
poly E4 = (A1*B3d - 3*A1d*B3) + 2*(A2*B2d - A2d*B2);
poly E5 = 2*A2*B3d - 3*A2d*B3;

// ---- u-degree ranges (= scalar equation counts) ----
// uu is variable number 73 (a(1..25), b(1..47), uu, x, y).
proc udegmax(poly f)
{
  intvec w = 0;
  int n = nvars(basering);
  w = intvec(n);
  w[73] = 1;
  return(deg(f, w));
}
proc udegmin(poly f)
{
  int m = 0;
  poly g = f;
  while (g != 0)
  {
    if (subst(g, uu, 0) != 0) { break; }
    g = g/uu;
    m = m + 1;
  }
  return(m);
}
int lo; int hi;
lo = udegmin(E1); hi = udegmax(E1);
print("E1: u in [" + string(lo) + "," + string(hi) + "], eqs=" + string(hi-lo+1));
lo = udegmin(E2); hi = udegmax(E2);
print("E2: u in [" + string(lo) + "," + string(hi) + "], eqs=" + string(hi-lo+1));
lo = udegmin(E3); hi = udegmax(E3);
print("E3: u in [" + string(lo) + "," + string(hi) + "], eqs=" + string(hi-lo+1));
lo = udegmin(E4); hi = udegmax(E4);
print("E4: u in [" + string(lo) + "," + string(hi) + "], eqs=" + string(hi-lo+1));
lo = udegmin(E5); hi = udegmax(E5);
print("E5: u in [" + string(lo) + "," + string(hi) + "], eqs=" + string(hi-lo+1));

// ---- identity check ----
// y^4*(J - x^2) =?= y^4*E1 + y^3*E2 + y^2*E3 + y*E4 + E5 - u^2, uu -> x*y^2.
poly E1xy = subst(E1, uu, x*y^2);
poly E2xy = subst(E2, uu, x*y^2);
poly E3xy = subst(E3, uu, x*y^2);
poly E4xy = subst(E4, uu, x*y^2);
poly E5xy = subst(E5, uu, x*y^2);
poly LHS = y^4*(J - x^2);
poly RHS = y^4*E1xy + y^3*E2xy + y^2*E3xy + y*E4xy + E5xy - (x*y^2)^2;
print("identity residual == 0 ? " + string((LHS - RHS) == 0));
print("C1 done.");
quit;
