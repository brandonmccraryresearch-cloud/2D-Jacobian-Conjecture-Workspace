/-- **Lower-edge rigidity on the K₅ torus orbit, for `P` and `Q`.**  Every coefficient of `P` off its top edge
`j = 2i − 2` and every coefficient of `Q` off its top edge `l = 2k − 3`, except the constant terms, vanishes. -/
theorem rigid_K5_PQ {L : Type*} [Field L] [CharZero L] (w : L)
    (hw : w ^ 5 - w ^ 4 + 3 * w ^ 3 + 3 * w ^ 2 + 26 = 0) (lam : L) (P Q : MvPolynomial (Fin 2) L)
    (hP : ∀ m ∈ P.support, inNP m) (hQ : ∀ m ∈ Q.support, inNQ m)
    (hJ : jac P Q = C lam * X 0 ^ 2) (ρ σ ε : L) (hρ : ρ ≠ 0) (hσ : σ ≠ 0) (hε : ε ≠ 0)
    (tP : ∀ i, 1 ≤ i → i ≤ 8 → P.coeff (mono i (2 * i - 2)) = ρ * ε ^ (i - 1) * topA w i)
    (tQ : ∀ k, 2 ≤ k → k ≤ 12 → Q.coeff (mono k (2 * k - 3)) = σ * ε ^ (k - 2) * topB w k) :
    (∀ i j, 2 * i ≤ j + 1 → (i, j) ≠ (0, 0) → P.coeff (mono i j) = 0) ∧
      (∀ k l, 2 * k ≤ l + 2 → (k, l) ≠ (0, 0) → Q.coeff (mono k l) = 0) := by
  obtain ⟨hPs, hQs⟩ := layers_of_support P Q hP hQ
  have hJ' : jac (layerPiece P 0 + layerPiece P 1 + layerPiece P 2)
      (layerPiece Q 0 + layerPiece Q 1 + layerPiece Q 2 + layerPiece Q 3) = C lam * X 0 ^ 2 := by
    rw [← hPs, ← hQs]; exact hJ
  have sA₀ : ∀ i, (layerPoly P 0).coeff i ≠ 0 → 0 ≤ i ∧ i ≤ 8 :=
    layerPoly_support P 0 inNP hP 0 8 (fun i ha h => by unfold inNP at h; simp at h; omega)
  have sA₁ : ∀ i, (layerPoly P 1).coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 8 :=
    layerPoly_support P 1 inNP hP 1 8 (fun i ha h => by unfold inNP at h; simp at h; omega)
  have sA₂ : ∀ i, (layerPoly P 2).coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 8 :=
    layerPoly_support P 2 inNP hP 1 8 (fun i ha h => by unfold inNP at h; simp at h; omega)
  have sB₀ : ∀ i, (layerPoly Q 0).coeff i ≠ 0 → 0 ≤ i ∧ i ≤ 12 :=
    layerPoly_support Q 0 inNQ hQ 0 12 (fun i ha h => by unfold inNQ at h; simp at h; omega)
  have sB₁ : ∀ i, (layerPoly Q 1).coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 12 :=
    layerPoly_support Q 1 inNQ hQ 1 12 (fun i ha h => by unfold inNQ at h; simp at h; omega)
  have sB₂ : ∀ i, (layerPoly Q 2).coeff i ≠ 0 → 2 ≤ i ∧ i ≤ 12 :=
    layerPoly_support Q 2 inNQ hQ 2 12 (fun i ha h => by unfold inNQ at h; simp at h; omega)
  have sB₃ : ∀ i, (layerPoly Q 3).coeff i ≠ 0 → 2 ≤ i ∧ i ≤ 12 :=
    layerPoly_support Q 3 inNQ hQ 2 12 (fun i ha h => by unfold inNQ at h; simp at h; omega)
  have t_a_1_0 := by
    have h := tP 1 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 1 (by norm_num)] at h
    exact h
  have t_a_2_2 := by
    have h := tP 2 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 2 (by norm_num)] at h
    exact h
  have t_a_3_4 := by
    have h := tP 3 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 3 (by norm_num)] at h
    exact h
  have t_a_4_6 := by
    have h := tP 4 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 4 (by norm_num)] at h
    exact h
  have t_a_5_8 := by
    have h := tP 5 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 5 (by norm_num)] at h
    exact h
  have t_a_6_10 := by
    have h := tP 6 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 6 (by norm_num)] at h
    exact h
  have t_a_7_12 := by
    have h := tP 7 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 7 (by norm_num)] at h
    exact h
  have t_a_8_14 := by
    have h := tP 8 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le P 2 8 (by norm_num)] at h
    exact h
  have t_b_2_1 := by
    have h := tQ 2 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 2 (by norm_num)] at h
    exact h
  have t_b_3_3 := by
    have h := tQ 3 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 3 (by norm_num)] at h
    exact h
  have t_b_4_5 := by
    have h := tQ 4 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 4 (by norm_num)] at h
    exact h
  have t_b_5_7 := by
    have h := tQ 5 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 5 (by norm_num)] at h
    exact h
  have t_b_6_9 := by
    have h := tQ 6 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 6 (by norm_num)] at h
    exact h
  have t_b_7_11 := by
    have h := tQ 7 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 7 (by norm_num)] at h
    exact h
  have t_b_8_13 := by
    have h := tQ 8 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 8 (by norm_num)] at h
    exact h
  have t_b_9_15 := by
    have h := tQ 9 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 9 (by norm_num)] at h
    exact h
  have t_b_10_17 := by
    have h := tQ 10 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 10 (by norm_num)] at h
    exact h
  have t_b_11_19 := by
    have h := tQ 11 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 11 (by norm_num)] at h
    exact h
  have t_b_12_21 := by
    have h := tQ 12 (by norm_num) (by norm_num)
    rw [← coeff_layerPoly_of_le Q 3 12 (by norm_num)] at h
    exact h
  obtain ⟨hA₁, hA₀, hB₂, hB₁, hB₀⟩ := rigid_K5 w hw lam (layerPoly P 0) (layerPoly P 1) (layerPoly P 2) (layerPoly Q 0) (layerPoly Q 1) (layerPoly Q 2) (layerPoly Q 3) (layerPiece P 0) (layerPiece P 1) (layerPiece P 2) (layerPiece Q 0) (layerPiece Q 1) (layerPiece Q 2) (layerPiece Q 3) (X1_pow_mul_layerPiece P 0) (X1_pow_mul_layerPiece P 1) (X1_pow_mul_layerPiece P 2) (X1_pow_mul_layerPiece Q 0) (X1_pow_mul_layerPiece Q 1) (X1_pow_mul_layerPiece Q 2) (X1_pow_mul_layerPiece Q 3) hJ' sA₀ sA₁ sA₂ sB₀ sB₁ sB₂ sB₃ ρ σ ε hρ hσ hε t_a_1_0 t_a_2_2 t_a_3_4 t_a_4_6 t_a_5_8 t_a_6_10 t_a_7_12 t_a_8_14 t_b_2_1 t_b_3_3 t_b_4_5 t_b_5_7 t_b_6_9 t_b_7_11 t_b_8_13 t_b_9_15 t_b_10_17 t_b_11_19 t_b_12_21
  constructor
  · intro i j hij hne
    by_cases hs : mono i j ∈ P.support
    · have hin := hP _ hs
      simp only [inNP, mono_apply_zero, mono_apply_one] at hin
      rcases (show j = 2 * i ∨ j + 1 = 2 * i by omega) with h | h
      · have hi : 1 ≤ i := by
          by_contra h0
          exact hne (Prod.ext (show i = 0 by omega) (show j = 0 by omega))
        have e := hA₀ i hi
        rw [coeff_layerPoly_of_le P 0 i (by omega)] at e
        obtain rfl : j = 2 * i - 0 := by omega
        exact e
      · have e := hA₁ i
        rw [coeff_layerPoly_of_le P 1 i (by omega)] at e
        obtain rfl : j = 2 * i - 1 := by omega
        exact e
    · exact notMem_support_iff.mp hs
  · intro k l hkl hne
    by_cases hs : mono k l ∈ Q.support
    · have hin := hQ _ hs
      simp only [inNQ, mono_apply_zero, mono_apply_one] at hin
      rcases (show l = 2 * k ∨ l + 1 = 2 * k ∨ l + 2 = 2 * k by omega) with h | h | h
      · have hk : 1 ≤ k := by
          by_contra h0
          exact hne (Prod.ext (show k = 0 by omega) (show l = 0 by omega))
        have e := hB₀ k hk
        rw [coeff_layerPoly_of_le Q 0 k (by omega)] at e
        obtain rfl : l = 2 * k - 0 := by omega
        exact e
      · have e := hB₁ k
        rw [coeff_layerPoly_of_le Q 1 k (by omega)] at e
        obtain rfl : l = 2 * k - 1 := by omega
        exact e
      · have e := hB₂ k
        rw [coeff_layerPoly_of_le Q 2 k (by omega)] at e
        obtain rfl : l = 2 * k - 2 := by omega
        exact e
    · exact notMem_support_iff.mp hs

/-- **Corollary `cor:a816` and Remark `rem:full-rigidity`, unconditional.**  Let `L` be a field of characteristic
zero and `P, Q ∈ L[x, y]` with support in `N(P) = conv{(0,0),(1,0),(8,14),(8,16)}` and
`N(Q) = conv{(0,0),(2,1),(12,21),(12,24)}`, `a₁,₀ a₈,₁₄ b₂,₁ b₁₂,₂₁ ≠ 0` and `J(P, Q) = λ x²`.  Then every
coefficient of `P` off its top edge `j = 2i − 2` and every coefficient of `Q` off its top edge `l = 2k − 3`, except
the constant terms, vanishes.  The top layer is classified by `chartClassification_holds` (Proposition 6.1);
`λ ≠ 0` and the vertex conditions at `(0,0)`, `(8,16)`, `(12,24)` are not used. -/
theorem lower_edge_rigidity {L : Type*} [Field L] [CharZero L] (P Q : MvPolynomial (Fin 2) L) (lam : L)
    (hP : ∀ m ∈ P.support, inNP m) (hQ : ∀ m ∈ Q.support, inNQ m)
    (v10 : P.coeff (mono 1 0) ≠ 0) (v814 : P.coeff (mono 8 14) ≠ 0)
    (w21 : Q.coeff (mono 2 1) ≠ 0) (w1221 : Q.coeff (mono 12 21) ≠ 0)
    (hJ : jac P Q = MvPolynomial.C lam * MvPolynomial.X 0 ^ 2) :
    (∀ i j, 2 * i ≤ j + 1 → (i, j) ≠ (0, 0) → P.coeff (mono i j) = 0) ∧
      (∀ k l, 2 * k ≤ l + 2 → (k, l) ≠ (0, 0) → Q.coeff (mono k l) = 0) := by
  obtain ⟨hPs, hQs⟩ := layers_of_support P Q hP hQ
  have hJ' : jac (layerPiece P 0 + layerPiece P 1 + layerPiece P 2)
      (layerPiece Q 0 + layerPiece Q 1 + layerPiece Q 2 + layerPiece Q 3) = C lam * X 0 ^ 2 := by
    rw [← hPs, ← hQs]; exact hJ
  obtain ⟨E5, -, -, -, -⟩ := layers_of_jac lam _ _ _ _ _ _ _ _ _ _ _ _ _ _
    (X1_pow_mul_layerPiece P 0) (X1_pow_mul_layerPiece P 1) (X1_pow_mul_layerPiece P 2)
    (X1_pow_mul_layerPiece Q 0) (X1_pow_mul_layerPiece Q 1) (X1_pow_mul_layerPiece Q 2)
    (X1_pow_mul_layerPiece Q 3) hJ'
  have sA₂ : ∀ i, (layerPoly P 2).coeff i ≠ 0 → 1 ≤ i ∧ i ≤ 8 :=
    layerPoly_support P 2 inNP hP 1 8 (fun i ha h => by unfold inNP at h; simp at h; omega)
  have sB₃ : ∀ i, (layerPoly Q 3).coeff i ≠ 0 → 2 ≤ i ∧ i ≤ 12 :=
    layerPoly_support Q 3 inNQ hQ 2 12 (fun i ha h => by unfold inNQ at h; simp at h; omega)
  have a1 : (layerPoly P 2).coeff 1 ≠ 0 := by rw [coeff_layerPoly_of_le P 2 1 (by norm_num)]; exact v10
  have a8 : (layerPoly P 2).coeff 8 ≠ 0 := by rw [coeff_layerPoly_of_le P 2 8 (by norm_num)]; exact v814
  have b2 : (layerPoly Q 3).coeff 2 ≠ 0 := by rw [coeff_layerPoly_of_le Q 3 2 (by norm_num)]; exact w21
  have b12 : (layerPoly Q 3).coeff 12 ≠ 0 := by rw [coeff_layerPoly_of_le Q 3 12 (by norm_num)]; exact w1221
  obtain ⟨w, ρ, σ, ε, hw, hρ, hσ, hε, hA, hB⟩ :=
    topLayerClassification_of_chart (chartClassification_holds L) _ _ lam sA₂ sB₃ a1 a8 b2 b12 E5
  refine rigid_K5_PQ w hw lam P Q hP hQ hJ ρ σ ε hρ hσ hε ?_ ?_
  · intro i hi1 hi8
    rw [← coeff_layerPoly_of_le P 2 i (by omega)]; exact hA i
  · intro k hk2 hk12
    rw [← coeff_layerPoly_of_le Q 3 k (by omega)]; exact hB k

/-- **Corollary `cor:a816`.**  Under the hypotheses of Theorem 1.1 (`λ ≠ 0` is not needed), `a₈,₁₆ = 0`. -/
theorem a816_eq_zero {L : Type*} [Field L] [CharZero L] (P Q : MvPolynomial (Fin 2) L) (lam : L)
    (hP : ∀ m ∈ P.support, inNP m) (hQ : ∀ m ∈ Q.support, inNQ m)
    (v10 : P.coeff (mono 1 0) ≠ 0) (v814 : P.coeff (mono 8 14) ≠ 0)
    (w21 : Q.coeff (mono 2 1) ≠ 0) (w1221 : Q.coeff (mono 12 21) ≠ 0)
    (hJ : jac P Q = MvPolynomial.C lam * MvPolynomial.X 0 ^ 2) : P.coeff (mono 8 16) = 0 :=
  (lower_edge_rigidity P Q lam hP hQ v10 v814 w21 w1221 hJ).1 8 16 (by norm_num) (by decide)

/-- **Theorem 1.1 through the lower edge.**  No `P, Q` satisfy `NewtonNF2` with `J(P, Q) = λ x²`: the vertex
`(8, 16)` already gives the contradiction.  The vertex condition `b₁₂,₂₄ ≠ 0` is not used (compare
`main_theorem`, which uses it). -/
theorem main_theorem_lower_edge {L : Type*} [Field L] [CharZero L] :
    ¬ ∃ (P Q : MvPolynomial (Fin 2) L) (lam : L), lam ≠ 0 ∧ NewtonNF2 P Q ∧ jac P Q = MvPolynomial.C lam * MvPolynomial.X 0 ^ 2 := by
  rintro ⟨P, Q, lam, -, ⟨hP, hQ, -, v10, v814, v816, -, w21, w1221, -⟩, hJ⟩
  exact v816 (a816_eq_zero P Q lam hP hQ v10 v814 w21 w1221 hJ)

end BranchAb
