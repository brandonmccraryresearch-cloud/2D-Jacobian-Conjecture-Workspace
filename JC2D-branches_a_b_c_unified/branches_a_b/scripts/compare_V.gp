Rr = w^5 - w^4 + 3*w^3 + 3*w^2 + 26;
psiv = [-1354018366437219946770101/34677998605729529856, -4570810593486307909212421/8669499651432382464, 158627918251542667511533/1926555478096084992, -741192801538899826344317/666884588571721728, -134767711178799475804590973/34677998605729529856];
u = Mod(Pol(psiv, w), Rr);
A = Mod((2904537848673965560983870231505961611216484953581987843838276864/3779357207149632914103290532850228636627298428125710781575310029109353)*w^0 + (-27139380915905548127415137801482954552161780107413095369243631360/3779357207149632914103290532850228636627298428125710781575310029109353)*w^1 + (30569988840281136299540789078923076865252792222802018120348518784/3779357207149632914103290532850228636627298428125710781575310029109353)*w^2 + (-11515632609329406031637838793544215559406566088372742650310149376/3779357207149632914103290532850228636627298428125710781575310029109353)*w^3 + (5180847076984791157406962461949350630412905296285784590160733184/3779357207149632914103290532850228636627298428125710781575310029109353)*w^4, Rr);
Sv = u^6 * A^7;
mp = minpoly(Sv, 'y);
V = subst(-1888043347611739526396142670327809715470336 + 586529490054134032292876680565455306752*S + 591414847960503971284831143987840*S^2 + 265472843532245531128968765*S^3 + 62410476400737833472*S^4 + 9374377445732*S^5, S, y);
print("deg minpoly(S) = ", poldegree(mp));
print("minpoly(Sv) (primitive integral) == paper V, coefficient for coefficient: ", mp == V);
print("real roots of V: ", polsturm(V), "   ", select(x->imag(x)==0, polroots(V)));
print("V irreducible: ", polisirreducible(V), "   W(t)=V(t^7) irreducible: ", polisirreducible(subst(V, y, t^7)));
print("V(Sv) == 0 exactly in K5: ", subst(V, y, Sv) == 0);
