    69 * (s - 38 * t ^ 2) ^ 2 = 69 * s ^ 2 + 8 * t ^ 2 * s + 50 * t ^ 4 := by
  have h101 : (101 : ZMod 101) = 0 := by decide
  linear_combination (-52 * t ^ 2 * s + 986 * t ^ 4) * h101

