// top_layer_m35.sing -- answer key R3d: the analogues m = 3, 5 of the top layer, exactly over Q.
// deg alpha = m, deg beta = e = (3m-1)/2, chart alpha_0 = beta_0 = alpha_m = 1; the u^k equations
// sum_{i+j=k} (1 + 2j - 3i) alpha_i beta_j = 0 for k = 1..m+e-1 (the u^(m+e) coefficient vanishes identically).
// beta_1..beta_e are solved recursively from k = 1..e; the rest are equations in alpha_1..alpha_{m-1}.
// Prints the number of solutions with multiplicity (vdim), the eliminant in alpha_{m-1}, and its factorization.
// Run: Singular -q top_layer_m35.sing   (a few seconds)
option(redSB); LIB "elim.lib";   // elim.lib also loads primdec.lib (radical)
proc topsys_m(int m)
{ // the basering has the variables a(1)..a(m-1); returns the equations k = e+1..m+e-1 after solving for beta
  int e = (3*m - 1) div 2; list A = 1; int i; int k; poly f;
  for (i = 1; i <= m - 1; i++) { A = A + list(var(i)); }
  A = A + list(1);                                    // A[i+1] = alpha_i, alpha_m = 1
  list B = 1;                                         // B[j+1] = beta_j
  for (k = 1; k <= e; k++) { f = 0;
    for (i = 1; i <= m; i++) { if (k - i >= 0) { f = f + (1 + 2*(k-i) - 3*i)*A[i+1]*B[k-i+1]; } }
    B = B + list(-f/(1 + 2*k)); }
  ideal I;
  for (k = e + 1; k <= m + e - 1; k++) { f = 0;
    for (i = 0; i <= m; i++) { if (k - i >= 0 && k - i <= e) { f = f + (1 + 2*(k-i) - 3*i)*A[i+1]*B[k-i+1]; } }
    I = I, f; }
  return(simplify(I, 2));
}
ring r3 = 0,(a(1..2)),dp;
ideal I3 = topsys_m(3); ideal G3 = std(I3);
"m = 3: equations"; size(I3); "dim"; dim(G3); "vdim (solutions with multiplicity)"; vdim(G3);
ideal E3 = eliminate(G3, a(1)); poly e3 = E3[1]; "eliminant in alpha_2 (monic):"; e3 / leadcoef(e3);
"factorization over Q:"; factorize(e3);
"vdim of the radical (distinct solutions):"; vdim(std(radical(I3)));
ring r5 = 0,(a(1..4)),dp;
ideal I5 = topsys_m(5); ideal G5 = std(I5);
"m = 5: equations"; size(I5); "dim"; dim(G5); "vdim (solutions with multiplicity)"; vdim(G5);
ideal E5 = eliminate(G5, a(1)*a(2)*a(3)); poly e5 = E5[1]; "eliminant in alpha_4 (monic):"; e5 / leadcoef(e5);
"factorization over Q:"; factorize(e5);
"vdim of the radical (distinct solutions):"; vdim(std(radical(I5)));
quit;
