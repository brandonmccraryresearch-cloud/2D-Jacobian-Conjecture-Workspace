ring R = 0, (a1,a2,a3,a4), dp;
option(redSB);
poly r0 = 512*a1^5*a3 - 896*a1^4*a2^2 - 1792*a1^4*a4 + 2624*a1^3*a2*a3 + 4032*a1^3 + 2128*a1^2*a2^3 - 3136*a1^2*a2*a4 - 4016*a1^2*a3^2 - 6536*a1*a2^2*a3 + 5208*a1*a2 + 13572*a1*a3*a4 - 539*a2^4 + 4389*a2^2*a4 + 5256*a2*a3^2 - 19812*a3 - 11011*a4^2;
poly r1 = 384*a1^4*a2*a3 - 672*a1^3*a2^3 - 1344*a1^3*a2*a4 - 256*a1^3*a3^2 + 2752*a1^2*a2^2*a3 + 3024*a1^2*a2 + 792*a1^2*a3*a4 + 1008*a1*a2^4 - 3346*a1*a2^2*a4 - 4912*a1*a2*a3^2 - 872*a1*a3 + 364*a1*a4^2 - 2648*a2^3*a3 + 4550*a2^2 + 12596*a2*a3*a4 + 2112*a3^3 - 25844*a4;
poly r2 = 256*a1^4*a3^2 - 448*a1^3*a2^2*a3 - 960*a1^3*a3*a4 + 112*a1^2*a2^2*a4 + 1536*a1^2*a2*a3^2 + 1600*a1^2*a3 + 224*a1^2*a4^2 + 672*a1*a2^3*a3 + 728*a1*a2^2 - 2788*a1*a2*a3*a4 - 2112*a1*a3^3 + 952*a1*a4 - 77*a2^3*a4 - 1560*a2^2*a3^2 + 1248*a2*a3 + 770*a2*a4^2 + 7392*a3^2*a4 - 15288;
poly r3 = 128*a1^4*a3*a4 - 224*a1^3*a2^2*a4 + 128*a1^3*a3 - 448*a1^3*a4^2 - 224*a1^2*a2^2 + 768*a1^2*a2*a3*a4 + 560*a1^2*a4 + 336*a1*a2^3*a4 + 872*a1*a2*a3 - 1176*a1*a2*a4^2 - 1056*a1*a3^2*a4 + 1008*a1 + 154*a2^3 - 780*a2^2*a3*a4 + 644*a2*a4 - 1056*a3^2 + 3432*a3*a4^2;
ideal S = r0, r1, r2, r3;
poly T = 9*a4^10 + 37200*a4^5 + 95051008;
poly L1 = 362*a4*a1 - 3*a4^5 - 13078;
poly L2 = 181*a4^2*a2 - 15*a4^5 - 32448;
poly L3 = 2172*a4^3*a3 - 861*a4^5 - 492128;
ideal J = T, L1, L2, L3;
system("--ticks-per-sec", 1000); int t0 = rtimer;
ideal GS = std(S); "std(S) ms:"; rtimer - t0; "size:"; size(GS); "vdim(S):"; vdim(GS); "dim(S):"; dim(GS);
ideal GJ = std(J); "vdim(J):"; vdim(GJ);
"J reduces to 0 mod std(S):"; size(reduce(J, GS)) == 0;
"S reduces to 0 mod std(J):"; size(reduce(S, GJ)) == 0;
t0 = rtimer; matrix CJ = lift(S, J); "lift(S,J) ms:"; rtimer - t0;
t0 = rtimer; matrix CS = lift(J, S); "lift(J,S) ms:"; rtimer - t0;
int i; int j; poly chk;
for (j = 1; j <= 4; j++) { chk = 0; for (i = 1; i <= 4; i++) { chk = chk + S[i]*CJ[i,j]; } if (chk != J[j]) { "LIFT S->J FAILED"; j; } }
for (j = 1; j <= 4; j++) { chk = 0; for (i = 1; i <= 4; i++) { chk = chk + J[i]*CS[i,j]; } if (chk != S[j]) { "LIFT J->S FAILED"; j; } }
"in-ring lift checks done";
link l1 = ":w lift_S_to_J.txt"; for (j = 1; j <= 4; j++) { for (i = 1; i <= 4; i++) { write(l1, string(j) + "|" + string(i) + "|" + string(CJ[i,j])); } } close(l1);
link l2 = ":w lift_J_to_S.txt"; for (j = 1; j <= 4; j++) { for (i = 1; i <= 4; i++) { write(l2, string(j) + "|" + string(i) + "|" + string(CS[i,j])); } } close(l2);
"wrote lift files";
quit;
