mapput(P, "a_1_0", Mod(1,R)); mapput(P, "b_2_1", Mod(1,R)); mapput(P, "a_2_2", Mod(1,R));
nf = nfinit(R);
print("class number: ", bnfinit(R,1).no);
print("disc: ", factor(nf.disc));
bnf = bnfinit(R, 1); nf = bnf.nf;
K = Vec(Mat(P)[,1]);
kexp(v) = {my(s=strsplit(v,"_"), i=eval(s[2])); if(s[1]=="a", i-1, i-2)};
coordsize(x) = {my(c = Vec(lift(x)), m = 0); for(j=1,#c, m = max(m, max(abs(numerator(c[j])), denominator(c[j])))); if(m==0,0,log(m)/log(10))};
cost(e) = {my(t=0); for(n=1,#K, if(K[n]=="lam", next); t += coordsize(mapget(P,K[n]) * e^kexp(K[n]))); t};
P2 = idealprimedec(nf, 2); P431 = idealprimedec(nf, 431); P571 = idealprimedec(nf, 571063277);
\\ identify which primes above 431 / 571063277 occur in a_3_4
x = lift(mapget(P,"a_3_4")); F = idealfactor(nf, x);
occ = []; for(r=1,#F~, if(F[r,1].p==431 || F[r,1].p==571063277, occ = concat(occ,[F[r,1]])));
p2occ = []; for(r=1,#F~, if(F[r,1].p==2, p2occ = concat(p2occ,[[F[r,1],F[r,2]]])));
print("p2 primes in a_3_4: ", #p2occ);
u = bnf.fu; print("unit rank: ", #u);
best = [10^9];
search() = {
  my(I, g, e0, e, c);
  for(va=-16,-11,
    for(vb=-4,-1,
      I = idealmul(nf, idealmul(nf, occ[1], occ[2]), idealmul(nf, idealpow(nf, p2occ[1][1], va), idealpow(nf, p2occ[2][1], vb)));
      g = bnfisprincipal(bnf, I, 1);
      \\ class number 1: always principal
      e0 = Mod(nfbasistoalg(nf, g[2]), R);
      for(i=-6,6,
        for(j=-6,6,
          for(s=0,1,
            e = e0 * Mod(nfbasistoalg(nf,u[1]),R)^i * Mod(nfbasistoalg(nf,u[2]),R)^j * (-1)^s;
            c = cost(e);
            if(c < best[1], best = [c, va, vb, i, j, s, e])
          )
        )
      )
    )
  );
}
search();
print("original cost: ", cost(Mod(1,R)));
print("best cost: ", best[1], "  va=", best[2], " vb=", best[3], " units=", best[4], ",", best[5], " sign=", best[6]);
print("e = ", lift(best[7]));
write("e_best.txt", lift(best[7]));
